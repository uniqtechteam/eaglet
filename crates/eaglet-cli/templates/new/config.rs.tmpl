//! Settings, read from the environment once at startup.

use eaglet::prelude::*;

/// Settings read from the environment.
#[derive(Debug, Clone)]
pub struct Config {
    /// `PORT`, 3000 by default.
    pub port: u16,
    /// `API_DOCS`: serve Swagger UI at `/docs`. On in debug builds; in release builds only when
    /// set to `true`, so a production server does not publish its API map by accident.
    pub api_docs: bool,
}

impl Config {
    /// Read the settings from the environment.
    #[must_use]
    pub fn from_env() -> Self {
        let port = std::env::var("PORT")
            .ok()
            .and_then(|p| p.parse().ok())
            .unwrap_or(3000);
        let api_docs = std::env::var("API_DOCS")
            .map_or(cfg!(debug_assertions), |v| v == "true" || v == "1");
        Self { port, api_docs }
    }
}

/// Import this module to inject `Arc<Config>` into a provider.
#[module(providers = [ProviderDef::value(Config::from_env())], exports = [Config])]
pub struct ConfigModule;
