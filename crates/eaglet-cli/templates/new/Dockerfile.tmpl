# syntax=docker/dockerfile:1
# the newest Rust 1.x: database drivers such as sqlx need a newer compiler than eaglet itself
FROM rust:1-slim-bookworm AS build
WORKDIR /app
COPY . .
# the registry and target caches survive between builds, so only changed crates are rebuilt
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release && cp target/release/{{crate}} /usr/local/bin/{{crate}}

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 app
COPY --from=build /usr/local/bin/{{crate}} /usr/local/bin/{{crate}}
USER app
ENV PORT=3000
EXPOSE 3000
CMD ["{{crate}}"]
