//! lumen errors become the right HTTP answers.

use eaglet::prelude::*;
use {{crate}}::db;

#[test]
fn lumen_errors_map_to_http_statuses() {
    let missing = db::http(lumen_orm::Error::not_found("user"));
    assert_eq!(missing.status(), StatusCode::NOT_FOUND);
    assert_eq!(missing.code(), "P2025");

    let duplicate = db::http(lumen_orm::Error::new("P2002", "a user with this email exists"));
    assert_eq!(duplicate.status(), StatusCode::CONFLICT);

    let hidden = db::http(lumen_orm::Error::new("P2010", "syntax error at or near"));
    assert_eq!(hidden.status(), StatusCode::INTERNAL_SERVER_ERROR);
    assert!(!hidden.message().contains("syntax"));
}
