//! What the {{plural_words}} routes accept and return.

use serde::{Deserialize, Serialize};
use utoipa::ToSchema;
use validator::Validate;

/// A stored {{singular_words}}.
#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]
pub struct {{Singular}} {
    /// Set by the server.
    pub id: u64,
    /// The display name.
    pub name: String,
}

/// The body of `POST /{{path}}`.
#[derive(Debug, Deserialize, Validate, ToSchema)]
pub struct Create{{Singular}} {
    /// The display name, 1 to 200 characters.
    #[validate(length(min = 1, max = 200))]
    pub name: String,
}

/// The body of `PATCH /{{path}}/:id`; fields left out stay as they are.
#[derive(Debug, Deserialize, Validate, ToSchema)]
pub struct Update{{Singular}} {
    /// The display name, 1 to 200 characters.
    #[validate(length(min = 1, max = 200))]
    pub name: Option<String>,
}
